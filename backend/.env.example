# ── Required ─────────────────────────────────────────────
# Railway: reference the Postgres service →  ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/triplei_oman"
# Long random strings (e.g. `openssl rand -hex 48`). Must differ from original Triple i's secrets.
JWT_SECRET=""
JWT_REFRESH_SECRET=""

# ── Recommended ──────────────────────────────────────────
NODE_ENV=production
# Public URL of the WEB APP (links in emails point here), not the API.
APP_URL="https://om.triplei.io"
# First person to sign up with this email becomes PLATFORM_ADMIN (staff console).
BOOTSTRAP_ADMIN_EMAIL=""
# Two-step verification for every user (defaults to true in production).
MFA_REQUIRED=true
# Allow self sign-up (true) or invitation-only (false).
ALLOW_PUBLIC_SIGNUP=true
# Where the "Triple i: Sustainability" card on the login chooser links to.
TRIPLEI_URL="https://app.triplei.io"

# ── Optional integrations ────────────────────────────────
# Transactional email (password reset, invitations, reminders). Without it emails are logged.
RESEND_API_KEY=""
RESEND_FROM="Triple i Oman <noreply@triplei.io>"
# AI tax assistant. Without it the assistant answers from the curated library only.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Fawtara partner ASP. 'sandbox' simulates the ASP; set 'http' + URL + key once a partner is contracted.
ASP_PROVIDER=sandbox
ASP_BASE_URL=""
ASP_API_KEY=""
# Origin(s) of the web app when it runs as a separate service (comma-separated, no trailing slash).
CORS_ORIGINS="https://om.triplei.io"
# Separate frontend service → the API does not serve the web app.
SERVE_FRONTEND=false
