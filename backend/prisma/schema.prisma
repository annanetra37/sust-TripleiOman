// Triple i Oman — Tax compliance automation platform
// Separate identity realm and database from original Triple i (plan §5.1).
// All money is stored as integer baisa (1 OMR = 1,000 baisa) in BigInt columns (plan E1-07).

generator client {
  provider   = "prisma-client-js"
  output     = "../node_modules/.prisma/client"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity (Triple i Oman realm only) ─────────────────────────

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  fullName       String
  phone          String?   // +968 mobile for SMS fallback
  locale         String    @default("en") // 'en' | 'ar'
  digitStyle     String    @default("western") // 'western' | 'arabic'
  showHijri      Boolean   @default(false)
  // Platform staff role (Triple i Oman employees). Null for customers.
  // 'PLATFORM_ADMIN' | 'TAX_SPECIALIST' | 'SUPPORT'
  platformRole   String?
  isActive       Boolean   @default(true)
  emailVerified  Boolean   @default(false)
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  recoveryCodes  Json      @default("[]") // array of bcrypt hashes
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  resetToken     String?   @unique
  resetExpiresAt DateTime?
  tokenVersion   Int       @default(0) // bump to revoke all refresh tokens
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships    Membership[]
  consents       ConsentRecord[]
  notifications  Notification[]
  pitProfiles    PitProfile[]
}

model ConsentRecord {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // 'PRIVACY_NOTICE' | 'TERMS' | 'MARKETING'
  version    String
  granted    Boolean  @default(true)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// ─── Organisations & roles ───────────────────────────────────────

model Organisation {
  id                  String    @id @default(uuid())
  legalNameEn         String
  legalNameAr         String?
  crNumber            String?   // Commercial Registration number
  legalForm           String?   // LLC, SAOC, SAOG, Sole proprietorship, Branch...
  activities          String?
  address             String?
  governorate         String?
  fiscalYearEndMonth  Int       @default(12)
  tin                 String?   // Tax Identification Number
  vatNumber           String?   // OM + 10 characters
  exciseNumber        String?
  vatRegistered       Boolean   @default(false)
  vatRegisteredAt     DateTime?
  vatGroupRepId       String?   // representative member of a VAT group (E1-06)
  annualSuppliesBaisa BigInt    @default(0) // declared / estimated annual taxable supplies
  employees           Int       @default(0)
  paidUpCapitalBaisa  BigInt    @default(0)
  profile             Json      @default("{}") // onboarding questionnaire answers
  obligationsSummary  Json      @default("[]") // last computed obligations with "why"
  plan                String    @default("FREE") // FREE | SME | BUSINESS | PRACTITIONER | PERSONAL
  isPractitionerFirm  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships   Membership[]
  invitations   Invitation[]
  obligations   Obligation[]
  transactions  Transaction[]
  importBatches ImportBatch[]
  returns       TaxReturn[]
  einvoices     EInvoice[]
  parties       Party[]
  whtPayments   WhtPayment[]
  documents     TaxDocument[]
  letters       TaxLetter[]
  accountMaps   AccountMapping[]
  supportGrants SupportAccessGrant[]
  exciseItems   ExciseProduct[]
}

// Roles (plan E0-05): OWNER, FINANCE_ADMIN, PREPARER, APPROVER, VIEWER, EXTERNAL_ACCOUNTANT, AUDITOR
model Membership {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           String
  status         String       @default("ACTIVE") // ACTIVE | REVOKED
  invitedById    String?
  createdAt      DateTime     @default(now())

  @@unique([userId, organisationId])
}

model Invitation {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  email          String
  role           String
  token          String       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())
}

// Just-in-time support access (E0-08): customer approves, time-boxed, every view logged.
model SupportAccessGrant {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  staffUserId    String
  reason         String
  status         String       @default("REQUESTED") // REQUESTED | APPROVED | DENIED | REVOKED
  approvedById   String?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
}

// ─── Tax rules library (rules are data, not code — plan decision 5) ──

model TaxRule {
  id             String    @id @default(uuid())
  key            String    // e.g. 'vat.rates', 'cit.rates', 'deadlines.vat'
  version        Int
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  value          Json
  sourceCitation String
  changeNote     String?
  status         String    @default("DRAFT") // DRAFT | APPROVED | REJECTED
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@unique([key, version])
  @@index([key, status])
}

// ─── Obligations & calendar (E2) ─────────────────────────────────

model Obligation {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  taxType        String       // VAT | CIT | WHT | EXCISE | PIT | EINVOICING | REGISTRATION | OTHER
  title          String
  titleAr        String?
  periodStart    DateTime?
  periodEnd      DateTime?
  dueDate        DateTime
  // NOT_STARTED → DATA_MISSING → READY_FOR_REVIEW → APPROVED → SUBMITTED → PAID → ACKNOWLEDGED
  status         String       @default("NOT_STARTED")
  ruleRef        String?
  notes          String?
  remindersSent  Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  returns        TaxReturn[]

  @@unique([organisationId, taxType, periodStart, periodEnd])
  @@index([organisationId, dueDate])
}

// ─── Data ingestion (E3) ─────────────────────────────────────────

model ImportBatch {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  source         String       // EXCEL | CSV | MANUAL | FAWTARA | ERP
  filename       String?
  rowCount       Int          @default(0)
  errorCount     Int          @default(0)
  errors         Json         @default("[]")
  createdById    String
  createdAt      DateTime     @default(now())

  transactions   Transaction[]
}

model Transaction {
  id                 String       @id @default(uuid())
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  importBatchId      String?
  importBatch        ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  direction          String       // SALE | PURCHASE
  date               DateTime
  invoiceNumber      String?
  counterpartyName   String?
  counterpartyVat    String?
  counterpartyCountry String      @default("OM")
  description        String?
  accountCode        String?
  netBaisa           BigInt
  vatBaisa           BigInt       @default(0)
  // STANDARD | ZERO_RATED | EXEMPT | OUT_OF_SCOPE | REVERSE_CHARGE
  vatCategory        String?
  categorySource     String?      // RULE | USER | IMPORT
  isService          Boolean      @default(false)
  isImport           Boolean      @default(false)
  isCreditNote       Boolean      @default(false)
  inputBlocked       Boolean      @default(false)
  hasTaxInvoice      Boolean      @default(true)
  flags              Json         @default("[]")
  lockedByReturnId   String?
  einvoiceId         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organisationId, date])
}

model AccountMapping {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  accountCode    String
  accountName    String?
  taxCategory    String       // VAT category or CIT schedule line
  history        Json         @default("[]")
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, accountCode])
}

// ─── Returns (VAT, CIT, WHT, EXCISE, PIT) with approval workflow (E4-07) ──

model TaxReturn {
  id              String       @id @default(uuid())
  organisationId  String
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  obligationId    String?
  obligation      Obligation?  @relation(fields: [obligationId], references: [id], onDelete: SetNull)
  taxType         String
  periodStart     DateTime
  periodEnd       DateTime
  // DRAFT | IN_REVIEW | APPROVED | REJECTED | SUBMITTED | PAID
  status          String       @default("DRAFT")
  boxes           Json         @default("{}")
  explanation     Json         @default("{}")
  exceptions      Json         @default("[]")
  inputs          Json         @default("{}") // stored inputs for reproducibility
  ruleVersions    Json         @default("{}")
  amountDueBaisa  BigInt       @default(0)
  preparedById    String
  submittedForReviewAt DateTime?
  reviewedById    String?
  reviewComment   String?
  approvedAt      DateTime?
  signatureHash   String?
  submissionRef   String?
  submittedAt     DateTime?
  paymentRef      String?
  paidAt          DateTime?
  locked          Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organisationId, taxType, periodStart])
}

// ─── Fawtara e-invoicing (E5) ────────────────────────────────────

model Party {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  kind           String       // CUSTOMER | SUPPLIER | BOTH
  nameEn         String
  nameAr         String?
  vatNumber      String?
  crNumber       String?
  country        String       @default("OM")
  address        String?
  city           String?
  email          String?
  peppolId       String?
  hasOmanPE      Boolean      @default(false) // permanent establishment (WHT, E7-04)
  residencyCertExpiry DateTime?
  createdAt      DateTime     @default(now())

  whtPayments    WhtPayment[]
}

model EInvoice {
  id               String       @id @default(uuid())
  organisationId   String
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  direction        String       @default("OUTBOUND") // OUTBOUND | INBOUND
  docType          String       @default("INVOICE")  // INVOICE | CREDIT_NOTE | DEBIT_NOTE
  kind             String       @default("B2B")      // B2B | B2C
  number           String
  issueDate        DateTime
  supplyDate       DateTime?
  currency         String       @default("OMR")
  buyer            Json         @default("{}")
  seller           Json         @default("{}")
  lines            Json         @default("[]")
  netBaisa         BigInt       @default(0)
  vatBaisa         BigInt       @default(0)
  totalBaisa       BigInt       @default(0)
  originalInvoiceId String?
  originalNumber   String?
  note             String?
  // DRAFT | VALID | INVALID | SENT | ACCEPTED | REJECTED | DELIVERED | RECEIVED
  status           String       @default("DRAFT")
  validationErrors Json         @default("[]")
  xml              String?
  sha256           String?
  qrPayload        String?
  aspMessageId     String?
  idempotencyKey   String?      @unique
  statusHistory    Json         @default("[]")
  createdById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organisationId, direction, number])
}

// ─── Withholding tax (E7) ────────────────────────────────────────

model WhtPayment {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  partyId        String
  party          Party        @relation(fields: [partyId], references: [id], onDelete: Restrict)
  paymentDate    DateTime
  category       String       // ROYALTIES | INTEREST | DIVIDENDS | TECHNICAL_SERVICES | MANAGEMENT_FEES | SOFTWARE | RESEARCH | EQUIPMENT_RENTAL | OTHER
  grossBaisa     BigInt
  netOfTax       Boolean      @default(false) // contract says "net of tax" → gross-up
  rateBp         Int          // basis points (1000 = 10%)
  treatyApplied  Boolean      @default(false)
  whtBaisa       BigInt
  explanation    Json         @default("{}")
  description    String?
  createdAt      DateTime     @default(now())
}

// ─── Excise (E8) ─────────────────────────────────────────────────

model ExciseProduct {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sku            String
  name           String
  category       String       // key from rules library excise.categories
  createdAt      DateTime     @default(now())

  @@unique([organisationId, sku])
}

// ─── Document vault, letters (E1, E11) ───────────────────────────

model TaxDocument {
  id             String        @id @default(uuid())
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  ownerUserId    String?       // personal (PIT) documents
  category       String        // CR_CERTIFICATE | TAX_CARD | VAT_CERTIFICATE | ACKNOWLEDGEMENT | PAYMENT_PROOF | LETTER | RECEIPT | FINANCIAL_STATEMENTS | RESIDENCY_CERT | OTHER
  title          String
  filename       String
  mimeType       String
  sizeBytes      Int
  sha256         String
  data           Bytes
  expiresAt      DateTime?
  relatedType    String?
  relatedId      String?
  uploadedById   String
  createdAt      DateTime      @default(now())

  @@index([organisationId, category])
}

model TaxLetter {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  reference      String?
  letterType     String       // INFORMATION_REQUEST | ASSESSMENT | AUDIT_NOTICE | PENALTY | REFUND | OTHER
  subject        String
  receivedAt     DateTime
  responseDueAt  DateTime?
  status         String       @default("OPEN") // OPEN | RESPONDED | OBJECTED | CLOSED
  assigneeId     String?
  notes          String?
  documentId     String?
  createdAt      DateTime     @default(now())
}

// ─── Personal income tax tracking (E9) ───────────────────────────

model PitProfile {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taxYear     Int
  data        Json     @default("{}") // incomes, deductions, travel log, foreign taxes
  updatedAt   DateTime @updatedAt

  @@unique([userId, taxYear])
}

// ─── Notifications (E13) ─────────────────────────────────────────

model Notification {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId String?
  type           String
  title          String
  body           String
  link           String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId, readAt])
}

// ─── Immutable, hash-chained audit log (E0-07) ───────────────────

model AuditLog {
  seq            BigInt   @id @default(autoincrement())
  organisationId String?
  actorId        String?
  actorLabel     String?
  action         String
  objectType     String?
  objectId       String?
  beforeHash     String?
  afterHash      String?
  details        Json     @default("{}")
  ip             String?
  userAgent      String?
  prevHash       String
  hash           String   @unique
  createdAt      DateTime @default(now())

  @@index([organisationId, createdAt])
}
